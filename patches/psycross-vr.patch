+		glUniform1i(sh->vrPassLoc, pass);
+		if (view) glUniformMatrix4fv(sh->vrViewLoc, 1, GL_FALSE, view);
+		if (proj) glUniformMatrix4fv(sh->vrProjLoc, 1, GL_FALSE, proj);
+		if (pass == 0) glUniform1i(sh->vrClipModeLoc, 0);
+	}
+	g_PreviousShader = -1;
+	g_currentPsxShader = NULL;
+#endif
+}
+
+void GR_VR_SetClip(int mode, const float* rect)
+{
+#if USE_OPENGL
+	for (int i = 0; i < 4; i++)
+	{
+		PSXGPU_Shader* sh = VR_Shaders(i);
+		glUseProgram(sh->shader);
+		glUniform1i(sh->vrClipModeLoc, mode);
+		if (rect) glUniform4fv(sh->vrClipLoc, 1, rect);
+	}
+	g_PreviousShader = -1;
+	g_currentPsxShader = NULL;
+#endif
+}
+
+void GR_VR_SetDisp(float x, float y)
+{
+#if USE_OPENGL
+	if (g_currentPsxShader)
+		glUniform2f(g_currentPsxShader->vrDispLoc, x, y);
+#endif
+}
+
+// Same 2D mapping as the on-screen path of GR_SetOffscreenState, without touching render targets.
+void GR_VR_SetFlatProjection()
+{
+#if USE_PGXP
+	const float emuScreenAspect = (float)(g_windowWidth) / (float)(g_windowHeight);
+	GR_Ortho2D(-0.5f * emuScreenAspect * PSX_SCREEN_ASPECT, 0.5f * emuScreenAspect * PSX_SCREEN_ASPECT, 0.5f, -0.5f, -1.0f, 1.0f);
+#else
+	GR_Ortho2D(0, activeDispEnv.disp.w, activeDispEnv.disp.h, 0, -1.0f, 1.0f);
+#endif
+}
+
+// Leave the GL state caches coherent after foreign code changed programs or textures.
+void GR_VR_InvalidateCaches()
+{
+	g_PreviousShader = -1;
+	g_currentPsxShader = NULL;
+	g_lastBoundTexture = 0;
+}

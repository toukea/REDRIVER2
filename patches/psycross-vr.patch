+//------------------------------------------------------------------------------------------------------------------------
+// [VR] Frame recording. Every on-screen draw of the frame is kept so the headset can replay it
+// for each eye, several times per simulation step, with the latest head pose.
+
+struct VRChunk
+{
+	int base;
+	int firstSplit;
+	int numSplits;
+};
+
+static int s_vrRecord = 0;
+static std::vector<GrVertex> s_vrVertices;
+static std::vector<GPUDrawSplit> s_vrSplits;
+static std::vector<VRChunk> s_vrChunks;
+static int s_vrWorldVertices = 0;
+static int s_vrOverlayVertices = 0;
+static int s_vrUploaded = 0;
+
+#if USE_OPENGL
+static GLuint s_vrVAO = 0;
+static GLuint s_vrVBO = 0;
+static size_t s_vrCapacity = 0;
+#endif
+
+void GR_VR_EnableRecording(int enable)
+{
+	s_vrRecord = enable;
+	if (!enable)
+		GR_VR_ClearRecord();
+}
+
+void GR_VR_ClearRecord()
+{
+	s_vrVertices.clear();
+	s_vrSplits.clear();
+	s_vrChunks.clear();
+	s_vrWorldVertices = 0;
+	s_vrOverlayVertices = 0;
+	s_vrUploaded = 0;
+}
+
+int GR_VR_RecordedVertices(int world)
+{
+	return world ? s_vrWorldVertices : s_vrOverlayVertices;
+}
+
+void GR_VR_SetSpriteDepth(int enable)
+{
+	g_vrSpriteDepth = enable;
+}
+
+static void VR_RecordSplits()
+{
+	if (!s_vrRecord || g_vertexIndex <= 0)
+		return;
+
+	VRChunk chunk;
+	chunk.base = (int)s_vrVertices.size();
+	chunk.firstSplit = (int)s_vrSplits.size();
+
+	for (int i = 1; i <= g_splitIndex; i++)
+	{
+		const GPUDrawSplit& split = g_splits[i];
+		if (!split.drawenv.dfe || split.numVerts == 0)
+			continue;	// render-to-VRAM passes are not part of the view
+
+		s_vrSplits.push_back(split);
+		for (int v = split.startVertex; v < split.startVertex + split.numVerts; v++)
+		{
+#if USE_PGXP
+			if (g_vertexBuffer[v].scr_h > 1.0f) s_vrWorldVertices++;
+			else s_vrOverlayVertices++;
+#else
+			s_vrOverlayVertices++;
+#endif
+		}
+	}
+
+	chunk.numSplits = (int)s_vrSplits.size() - chunk.firstSplit;
+	if (chunk.numSplits == 0)
+		return;
+
+	s_vrVertices.insert(s_vrVertices.end(), g_vertexBuffer, g_vertexBuffer + g_vertexIndex);
+	s_vrChunks.push_back(chunk);
+	s_vrUploaded = 0;
+}
+
+static void VR_UploadRecord()
+{
+#if USE_OPENGL
+	GLint previousBuffer = 0;
+	glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &previousBuffer);
+
+	if (!s_vrVAO)
+	{
+		glGenVertexArrays(1, &s_vrVAO);
+		glGenBuffers(1, &s_vrVBO);
+	}
+
+	glBindVertexArray(s_vrVAO);
+	glBindBuffer(GL_ARRAY_BUFFER, s_vrVBO);
+
+	const size_t bytes = s_vrVertices.size() * sizeof(GrVertex);
+	if (bytes > s_vrCapacity)
+	{
+		s_vrCapacity = bytes + bytes / 2;
+		glBufferData(GL_ARRAY_BUFFER, s_vrCapacity, NULL, GL_STREAM_DRAW);
+	}
+	if (bytes)
+		glBufferSubData(GL_ARRAY_BUFFER, 0, bytes, s_vrVertices.data());
+
+	glEnableVertexAttribArray(a_position);
+	glEnableVertexAttribArray(a_texcoord);
+	glEnableVertexAttribArray(a_color);
+	glEnableVertexAttribArray(a_extra);
+#if USE_PGXP
+	glEnableVertexAttribArray(a_zw);
+	glVertexAttribPointer(a_position, 4, GL_FLOAT, GL_FALSE, sizeof(GrVertex), &((GrVertex*)NULL)->x);
+	glVertexAttribPointer(a_zw, 4, GL_FLOAT, GL_FALSE, sizeof(GrVertex), &((GrVertex*)NULL)->z);
+#else
+	glVertexAttribPointer(a_position, 4, GL_SHORT, GL_FALSE, sizeof(GrVertex), &((GrVertex*)NULL)->x);
+#endif
+	glVertexAttribPointer(a_texcoord, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GrVertex), &((GrVertex*)NULL)->u);
+	glVertexAttribPointer(a_color, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(GrVertex), &((GrVertex*)NULL)->r);
+	glVertexAttribPointer(a_extra, 4, GL_BYTE, GL_FALSE, sizeof(GrVertex), &((GrVertex*)NULL)->tcx);
+
+	glBindVertexArray(0);
+	glBindBuffer(GL_ARRAY_BUFFER, previousBuffer);
+#endif
+	s_vrUploaded = 1;
+}
+
+void GR_VR_DrawRecorded(int pass)
+{
+#if USE_OPENGL
+	if (s_vrChunks.empty())
+		return;
+
+	if (!s_vrUploaded)
+		VR_UploadRecord();
+
+	glBindVertexArray(s_vrVAO);
+	GR_SetScissorState(0);
+
+	for (size_t c = 0; c < s_vrChunks.size(); c++)
+	{
+		const VRChunk& chunk = s_vrChunks[c];
+		for (int i = chunk.firstSplit; i < chunk.firstSplit + chunk.numSplits; i++)
+		{
+			const GPUDrawSplit& split = s_vrSplits[i];
+
+			GR_SetStencilMode(split.drawPrimMode);
+			GR_SetTexture(split.textureId, split.texFormat);
+			if (split.texFormat == TF_32_BIT_RGBA)
+				GR_SetOverrideTextureSize(split.drawenv.tw.w, split.drawenv.tw.h);
+			GR_SetBlendMode(split.blendMode);
+
+			// PGXP keeps x / dispW and y / dispH: rescale to an isotropic camera space
+			// (Driver 2 maps a 4:3 picture onto its PSX display).
+			const float dispH = split.dispenv.disp.h > 0 ? (float)split.dispenv.disp.h : 240.0f;
+			GR_VR_SetDisp(dispH * 4.0f / 3.0f, dispH);
+			GR_VR_SetFlatProjection();
+
+			glDrawArrays(GL_TRIANGLES, chunk.base + split.startVertex, split.numVerts);
+		}
+	}
+
+	glBindVertexArray(0);
+#endif
+}
+
 //
 // Draws all polygons after AggregatePTAG
 //
@@ -790,6 +984,8 @@ void DrawAllSplits()
 	for (int i = 1; i <= g_splitIndex; i++)
 		DrawSplit(g_splits[i]);
 
+	VR_RecordSplits();
+
 	ClearSplits();
 }
 
